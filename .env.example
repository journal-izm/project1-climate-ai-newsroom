# live 모드: OpenWeather 현재 날씨
OPENWEATHER_API_KEY=

# live 모드: 기상청 기상특보 조회(data.go.kr 서비스키)
KMA_SERVICE_KEY=
KMA_ALERT_API_URL=https://apihub.kma.go.kr/api/typ01/url/wrn_now_data.php

# AI 기사·임베딩·LLM 검토. 비어 있으면 데모 기사와 규칙 검증만 사용합니다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# demo 또는 live
APP_MODE=demo
